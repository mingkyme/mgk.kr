---
import ToolLayout from '../../layouts/ToolLayout.astro';
const characterKinds = [
  { key: 'uppercase', label: '대문자' }, { key: 'lowercase', label: '소문자' },
  { key: 'digits', label: '숫자' }, { key: 'symbols', label: '기호' },
];
---
<ToolLayout title="비밀번호 생성기" description="Web Crypto 난수로 로컬에서 비밀번호를 생성합니다." eyebrow="Password · Web Crypto">
  <div class="form-grid">
    <div class="two-column">
      <div class="field"><label for="password-length">길이 (8~128)</label><input id="password-length" type="number" min="8" max="128" step="1" value="20" /></div>
      <div class="field"><label for="password-count">개수 (1~100)</label><input id="password-count" type="number" min="1" max="100" step="1" value="1" /></div>
    </div>
    <fieldset><legend>사용할 ASCII 문자 종류</legend><div class="actions">
      <label><input id="password-uppercase" type="checkbox" checked /> 대문자 A–Z</label>
      <label><input id="password-lowercase" type="checkbox" checked /> 소문자 a–z</label>
      <label><input id="password-digits" type="checkbox" checked /> 숫자 0–9</label>
      <label><input id="password-symbols" type="checkbox" checked /> 기호 (공백 제외)</label>
    </div></fieldset>
    <label><input id="password-exclude-similar" type="checkbox" /> 비슷한 문자 제외 (I l 1 O 0 o | 및 따옴표)</label>
    <label><input id="password-require-each" type="checkbox" checked /> 선택한 종류를 각각 최소 1개 포함 (아래 최소값과 함께 적용)</label>
    <fieldset aria-describedby="password-ranges-help">
      <legend>문자 종류별 개수</legend>
      <p id="password-ranges-help">최소는 0~128, 최대는 빈칸이면 전체 길이까지 허용합니다. 최소와 최대를 같게 입력하면 정확한 개수가 됩니다. 선택하지 않은 종류의 설정은 적용하지 않습니다.</p>
      <div class="password-ranges">
        {characterKinds.map(kind => <div class="password-range-row">
          <span class="password-kind">{kind.label}</span>
          <div class="field"><label for={`password-${kind.key}-min`}>{kind.label} 최소</label><input id={`password-${kind.key}-min`} type="number" min="0" max="128" step="1" value="0" required /></div>
          <div class="field"><label for={`password-${kind.key}-max`}>{kind.label} 최대</label><input id={`password-${kind.key}-max`} type="number" min="0" max="128" step="1" placeholder="제한 없음" /></div>
        </div>)}
      </div>
    </fieldset>
    <div class="actions"><button id="password-generate" class="button" type="button">비밀번호 생성</button><button id="password-clear" class="button secondary" type="button">결과 지우기</button><button id="password-reset" class="button secondary" type="button">기본값으로 초기화</button></div>
    <p id="password-error" class="error" role="alert"></p><p id="password-status" role="status"></p>
    <label><input id="password-visible" type="checkbox" checked /> 결과 표시 (주변 사람에게 노출될 수 있음)</label>
    <div class="field"><label for="password-output">생성된 결과</label><textarea id="password-output" readonly autocomplete="off" spellcheck="false" aria-label="생성된 비밀번호"></textarea></div>
    <div class="actions"><button id="password-copy" class="button secondary" type="button" disabled>결과 복사</button><button id="password-download" class="button secondary" type="button" disabled>TXT 다운로드</button></div>
    <p>결과는 이 페이지 메모리에만 유지되며 저장하거나 전송하지 않습니다. 복사하면 시스템 클립보드에, 다운로드하면 평문 파일에 남습니다. 사용 후 지워 주세요. 사이트별 비밀번호 규칙을 확인하세요.</p>
  </div>
</ToolLayout>
<style>
  textarea[hidden] { display: none; }
  fieldset { min-width: 0; }
  .password-ranges { display: grid; gap: 16px; }
  .password-range-row { display: grid; grid-template-columns: minmax(60px, .6fr) repeat(2, minmax(0, 1fr)); gap: 12px; align-items: center; }
  .password-kind { font-weight: 600; }
  #password-ranges-help { color: var(--muted); }
  @media (max-width: 540px) { .password-range-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } .password-kind { grid-column: 1 / -1; } }
</style>
<script>
  import { generatePasswords, type PasswordCategory, type PasswordOptions } from '../../lib/password';
  const output = document.querySelector<HTMLTextAreaElement>('#password-output')!;
  const length = document.querySelector<HTMLInputElement>('#password-length')!;
  const count = document.querySelector<HTMLInputElement>('#password-count')!;
  const visible = document.querySelector<HTMLInputElement>('#password-visible')!;
  const error = document.querySelector<HTMLElement>('#password-error')!;
  const status = document.querySelector<HTMLElement>('#password-status')!;
  const copy = document.querySelector<HTMLButtonElement>('#password-copy')!;
  const download = document.querySelector<HTMLButtonElement>('#password-download')!;
  const checkbox = (id: string) => document.querySelector<HTMLInputElement>(`#password-${id}`)!;
  const categories: PasswordCategory[] = ['uppercase', 'lowercase', 'digits', 'symbols'];
  const rangeInput = (category: PasswordCategory, bound: 'min' | 'max') => document.querySelector<HTMLInputElement>(`#password-${category}-${bound}`)!;
  const updateRangeStates = () => categories.forEach(category => {
    rangeInput(category, 'min').disabled = rangeInput(category, 'max').disabled = !checkbox(category).checked;
  });
  updateRangeStates();
  let url = '';
  const clear = () => {
    output.value = ''; output.hidden = !visible.checked;
    error.textContent = status.textContent = '';
    copy.disabled = download.disabled = true;
    if (url) URL.revokeObjectURL(url); url = '';
  };
  document.querySelector('#password-generate')!.addEventListener('click', () => {
    clear();
    try {
      const ranges: PasswordOptions['ranges'] = {};
      for (const category of categories) {
        if (!checkbox(category).checked) continue;
        const min = rangeInput(category, 'min').value.trim();
        const max = rangeInput(category, 'max').value.trim();
        if (!min || rangeInput(category, 'min').validity.badInput || rangeInput(category, 'max').validity.badInput) throw new Error('최소 개수는 0~128 정수로 입력하고 최대는 정수 또는 빈칸으로 입력하세요.');
        ranges[category] = { min: Number(min), ...(max ? { max: Number(max) } : {}) };
      }
      const values = generatePasswords({ length: Number(length.value), count: Number(count.value), ranges,
        uppercase: checkbox('uppercase').checked, lowercase: checkbox('lowercase').checked,
        digits: checkbox('digits').checked, symbols: checkbox('symbols').checked,
        excludeSimilar: checkbox('exclude-similar').checked, requireEach: checkbox('require-each').checked });
      output.value = values.join('\n');
      copy.disabled = download.disabled = false;
      output.hidden = !visible.checked;
      status.textContent = `${values.length}개 생성했습니다. 결과가 ${visible.checked ? '표시되어' : '숨겨져'} 있습니다.`;
    } catch (cause) { error.textContent = cause instanceof Error ? cause.message : '생성에 실패했습니다.'; }
  });
  visible.addEventListener('change', () => {
    output.hidden = !visible.checked;
    if (output.value) status.textContent = `결과가 ${visible.checked ? '표시되어' : '숨겨져'} 있습니다.`;
  });
  copy.addEventListener('click', async () => {
    if (!output.value) return;
    try { await navigator.clipboard.writeText(output.value); status.textContent = '복사했습니다. 클립보드에 평문이 남습니다.'; }
    catch { error.textContent = '복사하지 못했습니다. 결과 표시 후 직접 복사하세요.'; }
  });
  download.addEventListener('click', () => {
    if (!output.value) return;
    if (url) URL.revokeObjectURL(url);
    url = URL.createObjectURL(new Blob([output.value], { type: 'text/plain;charset=utf-8' }));
    const link = document.createElement('a'); link.href = url; link.download = 'passwords.txt'; link.click();
  });
  length.addEventListener('input', clear); count.addEventListener('input', clear);
  categories.forEach(category => {
    rangeInput(category, 'min').addEventListener('input', clear);
    rangeInput(category, 'max').addEventListener('input', clear);
  });
  [...categories, 'exclude-similar', 'require-each'].forEach(id => checkbox(id).addEventListener('change', () => { updateRangeStates(); clear(); }));
  document.querySelector('#password-clear')!.addEventListener('click', clear);
  document.querySelector('#password-reset')!.addEventListener('click', () => {
    visible.checked = true; clear(); length.value = '20'; count.value = '1'; categories.forEach(id => { checkbox(id).checked = true; });
    checkbox('exclude-similar').checked = false; checkbox('require-each').checked = true;
    categories.forEach(category => { rangeInput(category, 'min').value = '0'; rangeInput(category, 'max').value = ''; });
    updateRangeStates();
  });
  window.addEventListener('pagehide', clear);
  document.addEventListener('astro:before-swap', clear);
</script>
