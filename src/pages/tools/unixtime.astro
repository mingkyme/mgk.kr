---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout title="Unix Time 변환" description="정수 Unix 초와 브라우저 로컬 날짜를 양방향으로 변환합니다. 로컬 시간대와 UTC를 선택할 수 있습니다." eyebrow="Unix seconds · Local / UTC">
  <div class="form-grid">
    <div class="field">
      <label for="unix-input">Unix 시간 (정수 초)</label>
      <input id="unix-input" type="text" inputmode="numeric" autocomplete="off" placeholder="1704067200" />
    </div>
    <div class="field">
      <label for="timezone">날짜 입력·표시 시간대</label>
      <select id="timezone"><option value="local">로컬 (브라우저 시간대)</option><option value="utc">UTC</option></select>
      <p id="time-zone" class="status" aria-live="polite"></p>
    </div>
    <div class="actions">
      <button class="button" id="unix-to-date" type="button">Unix → 날짜</button>
      <button class="button secondary" id="time-now" type="button">현재 시간</button>
      <button class="button secondary" id="copy-unix" type="button">Unix 복사</button>
    </div>
    <div class="field">
      <label for="date-input">날짜 (선택한 시간대) 또는 오프셋 포함 ISO</label>
      <input id="date-input" type="text" autocomplete="off" placeholder="2024-01-01 09:00:00" aria-describedby="date-help time-zone" />
      <p id="date-help" class="status">YYYY-MM-DD HH:mm:ss (초 생략 가능, T 구분자 가능). 날짜만 입력하면 선택한 시간대의 자정입니다. Z 또는 +09:00 등 오프셋이 있으면 그 시간대를 우선합니다.</p>
    </div>
    <div class="actions">
      <button class="button" id="date-to-unix" type="button">날짜 → Unix</button>
      <button class="button secondary" id="copy-date" type="button">날짜 복사</button>
    </div>
    <p id="time-detected" class="status" aria-live="polite"></p>
    <p id="time-error" class="error" role="alert"></p>
  </div>
</ToolLayout>
<script>
  import { formatDate, parseDateInput, parseUnixInput, toUnix, type Timezone } from '../../lib/time';
  import { copyFrom } from '../../lib/clipboard';
  const unix = document.querySelector<HTMLInputElement>('#unix-input')!;
  const date = document.querySelector<HTMLInputElement>('#date-input')!;
  const timezone = document.querySelector<HTMLSelectElement>('#timezone')!;
  const error = document.querySelector<HTMLElement>('#time-error')!;
  const detected = document.querySelector<HTMLElement>('#time-detected')!;
  const zone = document.querySelector<HTMLElement>('#time-zone')!;
  const mode = () => timezone.value as Timezone;
  const localZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  const showZone = (milliseconds: number) => {
    const offset = mode() === 'utc' ? 0 : -new Date(milliseconds).getTimezoneOffset();
    const pad = (value: number) => String(value).padStart(2, '0');
    zone.textContent = `${mode() === 'utc' ? 'UTC' : localZone} · UTC${offset >= 0 ? '+' : '-'}${pad(Math.floor(Math.abs(offset) / 60))}:${pad(Math.abs(offset) % 60)}`;
  };
  const clear = () => { error.textContent = ''; detected.textContent = ''; };
  // Bare wall clocks cannot distinguish the two instants during a DST overlap.
  let renderedDate: { value: string; milliseconds: number; timezone: Timezone } | null = null;
  date.addEventListener('input', () => { renderedDate = null; });
  const readDate = (timezone: Timezone) => renderedDate?.value === date.value && renderedDate.timezone === timezone
    ? renderedDate.milliseconds
    : parseDateInput(date.value, timezone);
  const render = (milliseconds: number) => {
    const wallClock = formatDate(milliseconds, mode());
    const utcClock = formatDate(milliseconds, 'utc');
    date.value = wallClock;
    unix.value = String(toUnix(milliseconds));
    detected.textContent = `UTC 기준: ${utcClock} UTC`;
    showZone(milliseconds);
    renderedDate = { value: wallClock, milliseconds, timezone: mode() };
  };
  const convertUnix = () => {
    clear();
    try { render(parseUnixInput(unix.value).milliseconds); }
    catch (cause) {
      renderedDate = null;
      date.value = '';
      zone.textContent = `${mode() === 'utc' ? 'UTC' : localZone} · 날짜 확인 필요`;
      error.textContent = cause instanceof Error ? cause.message : '변환할 수 없습니다.';
    }
  };
  document.querySelector('#unix-to-date')?.addEventListener('click', convertUnix);
  let selectedMode = mode();
  timezone.addEventListener('change', () => {
    clear();
    try {
      if (date.value.trim()) render(readDate(selectedMode));
      else if (unix.value.trim()) render(parseUnixInput(unix.value).milliseconds);
      else showZone(Date.now());
      selectedMode = mode();
    } catch (cause) {
      renderedDate = null;
      timezone.value = selectedMode;
      unix.value = '';
      detected.textContent = '';
      zone.textContent = `${selectedMode === 'utc' ? 'UTC' : localZone} · 날짜 확인 필요`;
      error.textContent = cause instanceof Error ? cause.message : '변환할 수 없습니다.';
    }
  });
  document.querySelector('#date-to-unix')?.addEventListener('click', () => {
    clear();
    try { render(readDate(mode())); }
    catch (cause) {
      renderedDate = null;
      unix.value = '';
      zone.textContent = `${mode() === 'utc' ? 'UTC' : localZone} · 날짜 확인 필요`;
      error.textContent = cause instanceof Error ? cause.message : '변환할 수 없습니다.';
    }
  });
  document.querySelector('#time-now')?.addEventListener('click', () => {
    clear();
    render(toUnix(Date.now()) * 1000);
  });
  showZone(Date.now());
  const copyUnix = document.querySelector<HTMLButtonElement>('#copy-unix')!;
  const copyDate = document.querySelector<HTMLButtonElement>('#copy-date')!;
  copyUnix.addEventListener('click', () => void copyFrom(copyUnix, unix.value));
  copyDate.addEventListener('click', () => void copyFrom(copyDate, date.value));
</script>
