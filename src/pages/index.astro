---
import BaseLayout from '../layouts/BaseLayout.astro';
import { toolCatalog } from '../data/tool-catalog';
import { homeSeo, toolGroups } from '../data/site-seo';
const groups = toolGroups.map(group => ({ ...group, entries: group.tools.map(key => toolCatalog.find(tool => tool.key === key)!) }));
const tools = groups.flatMap(group => group.entries);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://mgk.kr/#website', url: 'https://mgk.kr/', name: 'mgk.kr', description: homeSeo.description, inLanguage: 'ko' },
    {
      '@type': 'ItemList', '@id': 'https://mgk.kr/#tools', name: 'mgk.kr 도구 목록', numberOfItems: tools.length,
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem', position: index + 1,
        item: { '@type': 'SoftwareApplication', name: tool.title, description: tool.description, url: new URL(tool.href, 'https://mgk.kr').href, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' } },
      })),
    },
  ],
};
---
<BaseLayout title={homeSeo.title} description={homeSeo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="container">
    <section class="hero">
      <p class="eyebrow">mgk.kr · No sign-up</p>
      <h1>{homeSeo.h1}</h1>
      <p class="lede">{homeSeo.description}</p>
      <nav class="tool-categories" aria-label="도구 종류">
        {groups.map(group => <a class="button secondary" href={`#${group.id}`}>{group.title}</a>)}
      </nav>
    </section>
    <section class="section" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="sr-only">전체 도구 목록</h2>
      {groups.map(group => (
        <section class="tool-group" id={group.id} aria-labelledby={`${group.id}-heading`}>
          <h2 id={`${group.id}-heading`}>{group.title}</h2>
          <p class="group-description">{group.description}</p>
          <div class="grid">
            {group.entries.map(tool => (
              <a class="card tool-card" href={tool.href}>
                <h3>{tool.title}</h3>
                <p>{tool.description}</p>
                <span class="tag">{tool.tag} →</span>
              </a>
            ))}
          </div>
        </section>
      ))}
      <section class="tool-group" aria-labelledby="external-heading">
        <h2 id="external-heading">외부 참고 자료</h2>
        <div class="grid">
          <a class="card tool-card" href="https://docs.google.com/spreadsheets/d/1jQjS5NfNgZJFSjKmmt99Fwm1XJZWSkgcVwQRoqUrTow/edit?usp=sharing" target="_blank" rel="noopener noreferrer">
            <h3>병역일터 Datasheet</h3>
            <p>병역일터 IT 관련 채용 공고를 정리한 외부 Google Sheets 자료입니다.</p>
            <span class="tag">EXTERNAL ↗</span>
          </a>
        </div>
      </section>
    </section>
  </div>
</BaseLayout>
<style>
  .tool-categories { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
  .tool-group { margin-bottom: 48px; scroll-margin-top: 88px; }
  .tool-group h2 { margin-bottom: 12px; font-size: 28px; }
  .group-description { margin: 0 0 20px; color: var(--muted); }
</style>
