---
import BaseLayout from '../layouts/BaseLayout.astro';
import { toolCatalog } from '../data/tool-catalog';
const tools = toolCatalog;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://mgk.kr/#website', url: 'https://mgk.kr/', name: 'mgk.kr', description: '브라우저에서 빠르고 안전하게 사용하는 무료 개발자 유틸리티 모음', inLanguage: 'ko' },
    {
      '@type': 'ItemList', '@id': 'https://mgk.kr/#tools', name: 'mgk.kr 도구 목록', numberOfItems: tools.length,
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem', position: index + 1,
        item: { '@type': 'SoftwareApplication', name: tool.title, description: tool.description, url: new URL(tool.href, 'https://mgk.kr').href, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' } },
      })),
    },
  ],
};
---
<BaseLayout title="무료 개발자 도구 — 정규식·Cron·QR·UUID·PDF" description="정규식 테스트, Cron 설명, QR 코드·UUID·패스워드 생성부터 Base64, 텍스트·시간 변환과 PDF A4 분할까지 브라우저에서 무료로 사용하세요.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="container">
    <section class="hero">
      <p class="eyebrow">Private by default · No sign-up</p>
      <h1>무료 개발자 도구<br />텍스트·시간·PDF 작업</h1>
      <p class="lede">반복 작업을 덜어 주는 실용적인 유틸리티입니다. 입력 데이터는 가능한 한 브라우저 안에서만 처리합니다.</p>
    </section>
    <section class="section" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="sr-only">도구 목록</h2>
      <div class="grid">
        {tools.map((tool) => (
          <a class="card tool-card" href={tool.href}>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <span class="tag">{tool.tag} →</span>
          </a>
        ))}
        <a class="card tool-card" href="https://docs.google.com/spreadsheets/d/1jQjS5NfNgZJFSjKmmt99Fwm1XJZWSkgcVwQRoqUrTow/edit?usp=sharing" target="_blank" rel="noopener noreferrer">
          <h3>병역일터 Datasheet</h3>
          <p>병역일터 IT 관련 채용 공고를 정리한 외부 Google Sheets 자료입니다.</p>
          <span class="tag">EXTERNAL ↗</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
