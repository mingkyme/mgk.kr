---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/securecrt-config-maker.html', title: 'SecureCRT Config Maker', description: '서버 목록을 검증해 SecureCRT 세션 XML로 만듭니다.', tag: 'XML · SSH' },
  { href: '/tools/ssl-checker.html', title: 'SSL 명령어 생성기', description: '인증서 만료일과 체인 확인용 OpenSSL 명령을 안전하게 생성합니다.', tag: 'TLS · OpenSSL' },
  { href: '/tools/remove-duplication.html', title: '중복 라인 제거', description: '첫 등장 순서를 유지하며 빈 줄과 중복 항목을 정리합니다.', tag: 'TEXT' },
  { href: '/tools/sort.html', title: '라인 정렬', description: '한글과 숫자를 자연스럽게 인식해 오름차순 또는 내림차순으로 정렬합니다.', tag: 'TEXT · KO' },
  { href: '/tools/unixtime.html', title: 'Unix Time 변환', description: '초·밀리초 Unix 시간과 ISO/로컬 날짜를 양방향으로 변환합니다.', tag: 'TIME' },
  { href: '/tools/large-pdf-to-divided-images.html', title: 'PDF A4 분할', description: '파일을 업로드하지 않고 브라우저에서 큰 PDF 페이지를 A4로 분할합니다.', tag: 'LOCAL · PDF' },
  { href: '/tools/tsv-tool.html', title: 'TSV Tool', description: 'cat -T의 ^I 표시를 실제 탭 또는 줄바꿈으로 변환합니다.', tag: 'TEXT · TSV' },
  { href: '/tools/base64.html', title: 'Base64 인코더', description: 'Unicode 텍스트를 표준·URL-safe Base64로 인코딩하고 디코딩합니다.', tag: 'UTF-8 · JSON' },
  { href: '/tools/timer.html', title: 'LL-HLS 타이머', description: '밀리초 벽시계와 경과 시간으로 스트리밍 지연을 측정합니다.', tag: 'TIMER' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://mgk.kr/#website', url: 'https://mgk.kr/', name: 'mgk.kr', description: '브라우저에서 빠르고 안전하게 사용하는 무료 개발자 유틸리티 모음', inLanguage: 'ko' },
    {
      '@type': 'ItemList', '@id': 'https://mgk.kr/#tools', name: 'mgk.kr 도구 목록', numberOfItems: tools.length,
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem', position: index + 1,
        item: { '@type': 'SoftwareApplication', name: tool.title, description: tool.description, url: new URL(tool.href, 'https://mgk.kr').href, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' } },
      })),
    },
  ],
};
---
<BaseLayout title="mgk.kr" description="브라우저에서 빠르고 안전하게 사용하는 무료 개발자 유틸리티 모음입니다.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="container">
    <section class="hero">
      <p class="eyebrow">Private by default · No sign-up</p>
      <h1>작고 빠른<br />브라우저 도구들.</h1>
      <p class="lede">반복 작업을 덜어 주는 실용적인 유틸리티입니다. 입력 데이터는 가능한 한 브라우저 안에서만 처리합니다.</p>
    </section>
    <section class="section" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="sr-only">도구 목록</h2>
      <div class="grid">
        {tools.map((tool) => (
          <a class="card tool-card" href={tool.href}>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <span class="tag">{tool.tag} →</span>
          </a>
        ))}
        <a class="card tool-card" href="https://docs.google.com/spreadsheets/d/1jQjS5NfNgZJFSjKmmt99Fwm1XJZWSkgcVwQRoqUrTow/edit?usp=sharing" target="_blank" rel="noopener noreferrer">
          <h3>병역일터 Datasheet</h3>
          <p>병역일터 IT 관련 채용 공고를 정리한 외부 Google Sheets 자료입니다.</p>
          <span class="tag">EXTERNAL ↗</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
