---
import BaseLayout from './BaseLayout.astro';
import { guides, type ToolKey } from '../data/tool-guides';
interface Props { title: string; description: string; eyebrow?: string; }
const { eyebrow = 'Browser utility' } = Astro.props;
const key = Astro.url.pathname.split('/').pop()!.replace(/\.html$/, '') as ToolKey;
const guide = guides[key];
const { title, description } = guide;
const url = new URL(`/tools/${key}.html`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebApplication', '@id': `${url}#application`, name: title, description, url,
      applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', browserRequirements: 'JavaScript enabled', inLanguage: 'ko',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: '모든 도구', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ] },
  ],
};
---
<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="container narrow">
    <header class="tool-hero">
      <nav aria-label="현재 위치"><a class="back-link" href="/">← 모든 도구</a> <span aria-current="page"> / {title}</span></nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <section class="card tool-panel"><slot /></section>
    <div class="tool-guide">
      <section id="usage" aria-labelledby="usage-heading"><h2 id="usage-heading">사용 방법</h2><ol>{guide.steps.map(step => <li>{step}</li>)}</ol></section>
      <section id="examples" aria-labelledby="example-heading"><h2 id="example-heading">입력과 출력 예시</h2><p>{guide.example}</p><h3>입력</h3><pre>{guide.input}</pre><h3>출력</h3><pre>{guide.output}</pre></section>
      <section id="limitations" aria-labelledby="limit-heading"><h2 id="limit-heading">처리 방식과 주의사항</h2><p>{guide.limits}</p></section>
      <section id="faq" aria-labelledby="faq-heading"><h2 id="faq-heading">자주 묻는 질문</h2>{guide.faq.map(([question, answer]) => <div><h3>{question}</h3><p>{answer}</p></div>)}</section>
      <nav id="related-tools" aria-labelledby="related-heading"><h2 id="related-heading">{key === 'large-pdf-to-divided-images' ? '다른 브라우저 도구 둘러보기' : '함께 쓰기 좋은 도구'}</h2><ul>{guide.related.map(related => <li><a href={`/tools/${related}.html`}>{guides[related].title}</a></li>)}</ul></nav>
    </div>
  </div>
</BaseLayout>
